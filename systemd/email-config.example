# WhatsApp Scheduler Email Configuration
# 
# Copy this file to ~/.whatsapp-scheduler-email and fill in your credentials
# DO NOT commit the real file with credentials!
#
# For Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an app password for "Mail"
# 3. Use that 16-character password (without spaces)

EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_RECIPIENT=your-email@gmail.com
